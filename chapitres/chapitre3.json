{
    "titre":"chapitre3 - Ce dont on se souvient",
    "musique":"souvenir_melancolique",
    "fond":"bibliotheque_groupe",
    "debut":"debutChapitre3",
    "scenes":{
        "debutChapitre3":{
            "dialogues":[
                {
                    "personnage":"narrateur",
                    "texte":"Les photographies sont toujours étalées devant vous."
                },
                {
                    "personnage":"narrateur",
                    "texte":"Depuis que vous avez découvert la silhouette sur plusieurs images, certains souvenirs semblent changé de sens."
                },
                {
                    "personnage":"joueur",
                    "texte":"Depuis qu'on a vu ces photos... j'arrête pas de repenser à certains moments avec Eva. "
                },
                {
                    "personnage":"zoe",
                    "texte":"Moi aussi."
                },
                {
                    "personnage":"emelyne",
                    "texte":"A quels moments ?"
                }
            ],
            "next":"souvenirRepasIntroduction",
            "delai":900
        },

        "souvenirRepasIntroduction":{
            "dialogues":[
                {
                    "personnage":"joueur",
                    "texte":"La première fois qu'Eva et moi avons mangé seuls ensembles."
                },
                {
                    "personnage":"joueur",
                    "texte":"Elle étais nerveuse ce jour-là"
                },
                {
                    "personnage":"bryan",
                    "texte":"Tu pensais que c'était à cause de toi."
                },
                {
                    "personnage":"joueur",
                    "texte":"oui. C'était la première fois qu'on se retrouvait vraiment seuls."
                },
                {
                    "personnage":"narrateur",
                    "texte":"Tu ferme les yeux quelques secondes. Le souvenirs revient."
                }
            ],
            "next":"souvenirRepas",
            "delai":1200
        },

        "souvenirRepas":{
            "fond":"souvenir_repas_eva",
            "musique":"souvenir",
            "dialogues":[
                {
                    "personnage":"narrateur",
                    "texte":"Quelque semaines plus tôt..."
                },
                {
                    "personnage":"narrateur",
                    "texte":"Eva est assise en face de toi. Elle sourit, mais son regard quitte régulièrement le tien."
                },
                {
                    "personnage":"joueur",
                    "texte":"ça va ?"
                },
                {
                    "personnage":"eva",
                    "texte":"Oui, oui"
                },
                {
                    "personnage":"narrateur",
                    "texte":"Eva regarde brièvement derrière toi avant de revenir vers son assiette."
                },
                {
                    "personnage":"joueur",
                    "texte":"T'as l'air un peu stressée"
                },
                {
                    "personnage":"eva",
                    "texte":"Un peu."
                },
                {
                    "personnage":"narrateur",
                    "texte":"A ce moment-là, tu avais cru comprendre pourquoi. C'était votre premiers repas tous les deux."
                }
            ],
            "choix":[
                {
                    "texte":"Lui demander si c'est à cause de votre rendez-vous",
                    "message":{
                        "personnage":"joueur",
                        "texte":"C'est parce qu'on est tous les deux ?"
                    },
                    "next":"souvenirRepasReponse"
                },
                {
                    "texte":"Ne pas insister",
                    "message":{
                        "personnage":"joueur",
                        "texte":"D'accord. Si tu veux en parler, je suis là."
                    },
                    "effet":{
                        "souvenirRespectEva":1
                    },
                    "next":"souvenirRepasReponseAlternative"
                }
            ]
        },

        "souvenirRepasReponse":{
            "dialogues":[
                {
                    "personnage":"eva",
                    "texte":"Peut-être un peu."
                },
                {
                    "personnage":"narrateur",
                    "texte":"Elle sourit. Puis sont regard passe encore une fois derrière ton épaule."
                },
                {
                    "personnage":"narrateur",
                    "texte":"A l'époque, ce détail ne t'avait pas marqué."
                }
            ],
            "next":"retourRepas",
            "delai":1000
        },

        "souvenirRepasReponseAlternative":{
            "dialogues":[
                {
                    "personnage":"eva",
                    "texte":"Merci"
                },
                {
                    "personnage":"narrateur",
                    "texte":"Eva sourit avant de regarderr brièvement vers l'entrée"
                },
                {
                    "personnage":"narrateur",
                    "texte":"Quelques secondes plus tard, elle reprend la conversation comme si de rien était."
                }
            ],
            "next":"retourRepas",
            "delai":1000
        },

        "retourRepas":{
            "fond":"bibliotheque_groupe",
            "musique":"mystere_legere",
            "dialogues":[
                {
                    "personnage":"narrateur",
                    "texte":"Retour au présent"
                },
                {
                    "personnage":"joueur",
                    "texte":"J'étais persuadé qu'elle était stressée à cause de moi."
                },
                {
                    "personnage":"zoe",
                    "texte":"Et maintenant tu penses que c'était à cause de cette personne ?"
                }
            ],
            "choix":[
                {
                    "texte":"Dire que c'est possible",
                    "message":{
                        "personnage":"joueur",
                        "texte":"c'est possible. Elle regardait souvent derière moi."
                    },
                    "effet":{
                        "hypotheseEvaSuivie":1
                    },
                    "next":"miseEnGardeEmelyne"
                },
                {
                    "texte":"Dire que tu n'en sais rien",
                    "message":{
                        "personnage":"joueur",
                        "texte":"J'en sais rien. C'est justement ça le problème."
                    },
                    "effet":{
                        "prudence":1
                    },
                    "next":"miseEnGardeEmelyne"
                }
            ]
        },

        "miseEnGardeEmelyne":{
            "dialogues":[
                {
                    "personnage":"emelyne",
                    "texte":"On doit faire attention."
                },
                {
                    "personnage":"bryan",
                    "texte":"A quoi ?"
                },
                {
                    "personnage":"emelyne",
                    "texte":"Maintenant qu'on connaît cette silhouette, chaque comportement bizarre d'Eva va nous sembler lié à elle."
                },
                {
                    "personnage":"zoe",
                    "texte":"Et si c'était vraiment le cas ?"
                },
                {
                    "personnage":"emelyne",
                    "texte":"Justement on n'en sait rien."
                }
            ],
            "next":"souvenirZoeIntroduction",
            "delai":900
        },

        "souvenirZoeIntroduction":{
            "dialogues":[
                {
                    "personnage":"zoe",
                    "texte":"Il y a quand même quelque chose dont je me souviens."
                },
                {
                    "personnage":"joueur",
                    "texte":"Quoi ?"
                },
                {
                    "personnage":"zoe",
                    "texte":"Un soir après les cours, Eva m'avait demander de rester avec elle."
                },
                {
                    "personnage":"zoe",
                    "texte":"Sur le moment, j'avais même opas delmandé pourquoi."
                }
            ],
            "next":"souvenirZoe",
            "delai":900
        },

        "souvenirZoe":{
            "fond":"souvenir_couloir_eva_zoe",
            "musique":"souvenir",
            "dialogues":[
                {
                    "personnage":"narrateur",
                    "texte":"Quelques semaines avant la disparition..."
                },
                {
                    "personnage":"eva",
                    "texte":"Zoé ?"
                },
                {
                    "personnage":"zoe",
                    "texte":"Oui ?"
                },
                {
                    "personnage":"eva",
                    "texte":"Tu pars maintenant ?"
                },
                {
                    "personnage":"zoe",
                    "texte":"Non, j'ai encore un truc à faire. Pourquoi ?"
                },
                {
                    "personnage":"eva",
                    "texte":"Comme ça."
                },
                {
                    "personnage":"narrateur",
                    "texte":"Eva hésite quelques secondes"
                },
                {
                    "personnage":"eva",
                    "texte":"Tu pourrais m'attendre après ?"
                },
                {
                    "personnage":"zoe",
                    "texte":"ça va me prendre un moment."
                },
                {
                    "personnage":"eva",
                    "texte":"Pas grave. Oublie."
                },
                {
                    "personnage":"zoe",
                    "texte":"T'es sûr ?"
                },
                {
                    "personnage":"eva",
                    "texte":"Oui. T'inquiète"
                }
            ],
            "next":"retourSouvenirZoe",
            "delai":1200
        },

        "retourSouvenirZoe":{
            "fond":"bibliotheque_groupe",
            "musique":"mystere_legere",
            "dialogues":[
                {
                    "personnage":"zoe",
                    "texte":"Elle restait seule tout le temps."
                },
                {
                    "personnage":"zoe",
                    "texte":"Pourquoi elle m'aurait demandé de l'attendre ce jour-là"
                },
                {
                    "personnage":"bryan",
                    "texte":"Elle voulait peut-être juste passer du temps avec toi."
                },
                {
                    "personnage":"zoe",
                    "texte":"Peut-être. Mais maintenant, ça me paraît différent."
                }
            ],
            "next":"souvenirEmelyneIntroduction",
            "delai":850
        },

        "souvenirEmelyneIntroduction":{
            "dialogues":[
                {
                    "personnage":"emelyne",
                    "texte":"J'en ai un aussi."
                },
                {
                    "personnage":"joueur",
                    "texte":"Toi aussi ?"
                },
                {
                    "personnage":"emelyne",
                    "texte":"Dans un couloir de l'université."
                },
                {
                    "personnage":"emelyne",
                    "texte":"Eva, s'était arrêtée net en regardant quelqu'un."
                },
                {
                    "personnage":"emelyne",
                    "texte":"J'avais pensé qu'elle essayait juste d'éviter une connaissance."
                }
            ],
            "next":"souvenirEmelyne",
            "delai":900
        },

        "souvenirEmelyne":{
            "fond":"souvenir_couloir_emelyne_eva",
            "musique":"souvenir_tension",
            "dialogues":[
                {
                    "personnage":"narrateur",
                    "texte":"Dans le souvenir d'Emelyne, le couloir est rempli d'étudiants."
                },
                {
                    "personnage":"emelyne",
                    "texte":"Eva ?"
                },
                {
                    "personnage":"narrateur",
                    "texte":"Eva vient de ralentir brusquement."
                },
                {
                    "personnage":"eva",
                    "texte":"Hm ?"
                },
                {
                    "personnage":"emelyne",
                    "texte":"Tu viens ?"
                },
                {
                    "personnage":"eva",
                    "texte":"Oui."
                },
                {
                    "personnage":"narrateur",
                    "texte":"Eva regarde quelques secondes vers l'autre extrémité du couloir."
                },
                {
                    "personnage":"emelyne",
                    "texte":"Tu connais quelqu'un là-bas ?"
                },
                {
                    "personnage":"eva",
                    "texte":"Non"
                },
                {
                    "personnage":"narrateur",
                    "texte":"Elle reprend immédiatement sa marche"
                }
            ],
            "next":"retourSouvenirEmelyne",
            "delai":1200
        },

        "retourSouvenirEmelyne":{
            "fond":"bibliotheque_groupe",
            "musique":"mystere_legere",
            "dialogues":[
                {
                    "personnage":"emelyne",
                    "texte":"Je n'ai même pas regardé qui se trouvait au bout du couloir."
                },
                {
                    "personnage":"bryan",
                    "texte":"Donc ça pouvait être n'importe qui."
                },
                {
                    "personnage":"emelyne",
                    "texte":"Exactement."
                },
                {
                    "personnage":"zoe",
                    "texte":"Ou la silhouette."
                },
                {
                    "personnage":"emelyne",
                    "texte":"Ou la silhouette. Mais on ne peut pas le savoir."
                }
            ],
            "next":"souvenirFamille",
            "delai":900
        },

        "souvenirFamille":{
            "dialogues":[
                {
                    "personnage":"zoe",
                    "texte":"La soeur d'Eva m'avait aussi raconté quelque chose après sa disparition."
                },
                {
                    "personnage":"joueur",
                    "texte":"Quoi ?"
                },
                {
                    "personnage":"zoe",
                    "texte":"Eva luit demandait parfois si elle restait à la maison le soir."
                },
                {
                    "personnage":"zoe",
                    "texte":"Elle disait que c'était juste pour savoir"
                },
                {
                    "personnage":"emelyne",
                    "texte":"ça ne prouve rien non plus."
                },
                {
                    "personnage":"zoe",
                    "texte":"Je sais."
                }
            ],
            "next":"mettreToutEnsemble",
            "delai":900
        },

        "toutMettreEnsemble":{
            "fond":"bibliotheque_note",
            "musique":"tension_legere",
            "dialogues":[
                {
                    "personnage":"narrateur",
                    "texte":"Emelyne écrit les différents souvenirs à côté des dates des photographies."
                },
                {
                    "personnage":"narrateur",
                    "texte":"Le repas. La demande faite à Zoé. Le couloir. Les question posées à sa soeur."
                },
                {
                    "personnage":"narrateur",
                    "texte":"Pris séparément, aucun de ces événement ne prouve quoi que se soit."
                },
                {
                    "personnage":"narrateur",
                    "texte":"Placés à côté des photographies, ils deviennent beaucoup plus difficiles à ignorer."
                }
            ],
            "next":"choixHypothese",
            "delai":1100
        },

        "choixHypothese":{
            "dialogues":[
                {
                    "personnage":"bryan",
                    "texte":"Alors vous pansez quoi ?"
                },
                {
                    "personnage":"zoe",
                    "texte":"Que quelque chose se passait."
                },
                {
                    "personnage":"emelyne",
                    "texte":"ça, c'est possible. Mais on ne sait toujours pas quoi."
                }
            ],
            "choix":[
                {
                    "texte":"Eva avait peut-être peur de cette personne",
                    "message":{
                        "personnage":"joueur",
                        "texte":"Je pense qu'Eva avait peut-être peur de cette personne. ça expliquerait certains de ses comportements."
                    },
                    "effet":{
                        "hypotheseEvaDanger":1,
                        "hypothesePrincipale": "danger"
                    },
                    "next":"reactionHypothese"
                },
                {
                    "texte":"Eva connaissait peut-être cette personne",
                    "message":{
                        "personnage":"joueur",
                        "texte":"Ou Eva la connaissait. Elle cachait peut-être quelque chose sans forcément être en danger."
                    },
                    "effet":{
                        "hypotheseEvaConnaitSilhouette":1,
                        "hypothesePrincipale":"connaissance"
                    },
                    "next":"reactionHypothese"
                },
                {
                    "texte":"On relie peut-être des événements sans rapport",
                    "message":{
                        "personnage":"joueur",
                        "texte":"On doit aussi accepter qu'on est peut-être en train de relier des événements qui n'ont aucun rapport."
                    },
                    "effet":{
                        "prudence":2,
                        "hypothesePrincipale":"incertitude"
                    },
                    "next":"reactionHypothese"
                }
            ]
        },

        "reactionHypothese":{
            "dialogues":[
                {
                    "personnage":"emelyne",
                    "texte":"Pour l'instant, ce ne sont que des hypothèses. "
                },
                {
                    "personnage":"zoe",
                    "texte":"Mais on a quand même plus de question qu'hier"
                },
                {
                    "personnage":"bryan",
                    "texte":"Et toujours aucune idée de qui est cette personne."
                },
                {
                    "personnage":"joueur",
                    "texte":"Les souvenirs ne suffiront pas."
                }
            ],
            "next":"questionEnqueteur",
            "delai":850
        },

        "questionEnqueteur":{
            "fond":"souvenir_interogatoire",
            "musique":"souvenir_tension",
            "dialogues":[
                {
                    "personnage":"narrateur",
                    "texte":"La question de l'enquêteur te revient encore une fois."
                },
                {
                    "personnage":"lieutenant morel",
                    "texte":"Est-ce qu'Eva vous semblait différente ?"
                },
                {
                    "personnage":"lieutenant morel",
                    "texte":"Est-ce qu'elle vous avait donné l'empression de se sentir en danger ?"
                },
                {
                    "personnage":"narrateur",
                    "texte":"A l'époque, tu avais répondu avec ce que tu savais."
                },
                {
                    "personnage":"narrateur",
                    "texte":"Aujourd'hui, tu n'es plus certain de donner exactement la même réponse"
                }
            ],
            "next":"retourPresentFinal",
            "delai":1600
        },

        "retourPresentFinal":{
            "fond":"bibliotheque_groupe",
            "musique":"mystere",
            "dialogues":[
                {
                    "personnage":"zoe",
                    "texte":"Mes photos nous montre que cette personne était là."
                },
                {
                    "personnage":"emelyne",
                    "texte":"Nos souvenir nous montre seulement qu'Eva était parfois différentes"
                },
                {
                    "personnage":"bryan",
                    "texte":"Mais rien ne relie les deux."
                },
                {
                    "personnage":"joueur",
                    "texte":"Il nous faut quelque chose qui vienne d'Eva elle-mêm"
                },
                {
                    "personnage":"zoe",
                    "texte":"Ses messages."
                }
            ],
            "next":"preparationMessage",
            "delai":1000
        },

        "preparationMessage":{
            "dialogues":[
                {
                    "personnage":"zoe",
                    "texte":"Si Eva connaissait cette personne, elle en à surment parler à quelqu'un."
                },
                {
                    "personnage":"emelyne",
                    "texte":"Ou elle a peut-être envoyé un message sens expliquer clairement ce qui se passait."
                },
                {
                    "personnage":"joueur",
                    "texte":"Dans tous les cas, on doit chercher"
                },
                {
                    "personnage":"narrateur",
                    "texte":"Pour la première fois, vous allez arrêter d'interpréter ce que vous avez vu."
                },
                {
                    "personnage":"narrateur",
                    "texte":"Et commencer à chercher ce qu'eva elle-même avait laissé derrière elle."
                }
            ],
            "choix":[
                {
                    "texte":"commencer par les messages d'eva",
                    "message":{
                        "personnage":"joueur",
                        "texte":"On regarde ses messages. Peut-être qu'ils nous permettront enfin de comprendre ce qu'elle savait."
                    },
                    "effet":{
                        "pisteMessages":true
                    },
                    "next":"finChapitre3"
                }
            ]
        },
        
        "finChapitre3":{
            "fond":"noir",
            "musique":"mystere_legere",
            "dialogues":[
                {
                    "personnage":"narrateur",
                    "texte":"Des regards derrière une épaule."
                },
                {
                    "personnage":"narrateur",
                    "texte":"Une demande inhabutuelle faite à Zoé."
                },
                {
                    "personnage":"narrateur",
                    "texte":"Une hésitation dans un couloir."
                },
                {
                    "personnage":"narrateur",
                    "texte":"Des détails insignifiants au moment où ils se sont produits"
                },
                {
                    "personnage":"narrateur",
                    "texte":"Aujourd'hui, chacun d'eux semble pouvoir raconter une autres histoire."
                },
                {
                    "personnage":"narrateur",
                    "texte":"Les message d'eva, eux, pourraient être beaucoup plus difficiles à interpréter autrement."
                }
            ],
            "next":"chapitre4",
            "delai":2500
        }
    }
}