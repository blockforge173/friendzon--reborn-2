{
  "titre": "Chapitre 1 — Sans nouvelles",
  "musique": "tension_legere",
  "fond": "maison_eva_soiree",
  "debut": "retourApresCinematique",
  "scenes": {
    "retourApresCinematique": {
      "dialogues": [
        {
          "personnage": "narrateur",
          "texte": "Pendant quelques secondes, personne ne dit rien.",
          "fond": "maison_eva_salon_groupe"
        },
        {
          "personnage": "narrateur",
          "texte": "La pièce est pourtant pleine, mais le silence qui s'est installé donne l'impression qu'elle est complètement vide."
        },
        {
          "personnage": "joueur",
          "texte": "..."
        },
        {
          "personnage": "zoe",
          "texte": "Vous l'avez vue aussi... pas vrai ?"
        }
      ],
      "choix": [
        {
          "texte": "Demander de qui elle parle",
          "message": {
            "personnage": "joueur",
            "texte": "Tu parles de la personne qu'on a vue à la fin ?"
          },
          "next": "questionInconnu"
        },
        {
          "texte": "Dire que quelque chose ne colle pas",
          "message": {
            "personnage": "joueur",
            "texte": "Oui. Et je sais pas pourquoi, mais quelque chose ne colle pas."
          },
          "effet": {
            "intuition": 1
          },
          "next": "questionInconnu"
        },
        {
          "texte": "Rester silencieux",
          "message": {
            "personnage": "joueur",
            "texte": "..."
          },
          "next": "reactionSilence"
        }
      ]
    },

    "reactionSilence": {
      "dialogues": [
        {
          "personnage": "emelyne",
          "texte": "{{nomJoueur}} ?"
        },
        {
          "personnage": "joueur",
          "texte": "Je réfléchis."
        },
        {
          "personnage": "zoe",
          "texte": "Alors réfléchis vite... parce que moi je veux comprendre qui c'était."
        }
      ],
      "next": "questionInconnu",
      "delai": 1000
    },

    "questionInconnu": {
      "dialogues": [
        {
          "personnage": "zoe",
          "texte": "Cette personne était là. Près d'Eva."
        },
        {
          "personnage": "emelyne",
          "texte": "On ne sait même pas si elle a quelque chose à voir avec sa disparition."
        },
        {
          "personnage": "zoe",
          "texte": "Non. Mais pour l'instant, c'est plus que ce qu'on avait il y a cinq minutes."
        },
        {
          "personnage": "bryan",
          "texte": "Vous êtes en train de dire qu'on devrait commencer à enquêter nous-mêmes ?"
        }
      ],
      "choix": [
        {
          "texte": "Dire qu'il faut transmettre l'information à la police",
          "message": {
            "personnage": "joueur",
            "texte": "On devrait surtout transmettre ça à la police. Eux peuvent réellement vérifier cette piste."
          },
          "effet": {
            "prudence": 2,
            "relationEmelyne": 1
          },
          "next": "avisPolice"
        },
        {
          "texte": "Dire qu'il faut chercher à savoir qui est cette personne",
          "message": {
            "personnage": "joueur",
            "texte": "On peut prévenir la police, mais rien ne nous empêche d'essayer de comprendre qui est cette personne."
          },
          "effet": {
            "enquete": 2,
            "relationZoe": 1
          },
          "next": "chercherNousMeme"
        },
        {
          "texte": "Dire qu'il est trop tôt pour décider",
          "message": {
            "personnage": "joueur",
            "texte": "On vient juste de découvrir ça. Je pense qu'on devrait éviter de tirer des conclusions trop vite."
          },
          "effet": {
            "prudence": 1
          },
          "next": "temporiser"
        }
      ]
    },

    "avisPolice": {
      "dialogues": [
        {
          "personnage": "emelyne",
          "texte": "Je suis d'accord. S'il y a vraiment quelque chose à trouver, ils auront plus de moyens que nous."
        },
        {
          "personnage": "zoe",
          "texte": "Et s'ils passent à côté ?"
        },
        {
          "personnage": "emelyne",
          "texte": "Zoé..."
        },
        {
          "personnage": "zoe",
          "texte": "Quoi ? Je dis juste qu'on connaît Eva mieux qu'eux."
        }
      ],
      "next": "finSoiree",
      "delai": 1200
    },

    "chercherNousMeme": {
      "dialogues": [
        {
          "personnage": "zoe",
          "texte": "Merci. C'est exactement ce que j'essaye de dire."
        },
        {
          "personnage": "emelyne",
          "texte": "Chercher des informations, d'accord. Mais on ne fait rien de dangereux."
        },
        {
          "personnage": "bryan",
          "texte": "Donc on a déjà des règles avant même d'avoir commencé."
        },
        {
          "personnage": "emelyne",
          "texte": "Avec toi, je préfère."
        }
      ],
      "next": "finSoiree",
      "delai": 1200
    },

    "temporiser": {
      "dialogues": [
        {
          "personnage": "emelyne",
          "texte": "Pour une fois, quelqu'un réfléchit avant de foncer."
        },
        {
          "personnage": "zoe",
          "texte": "Je réfléchis."
        },
        {
          "personnage": "bryan",
          "texte": "Tu réfléchis très vite."
        },
        {
          "personnage": "zoe",
          "texte": "C'est toujours réfléchir."
        }
      ],
      "next": "finSoiree",
      "delai": 1200
    },

    "finSoiree": {
      "dialogues": [
        {
          "personnage": "narrateur",
          "texte": "La discussion continue encore longtemps.",
          "fond": "maison_eva_salon_nuit"
        },
        {
          "personnage": "narrateur",
          "texte": "Mais aucune théorie ne permet réellement d'expliquer ce qui est arrivé à Eva."
        },
        {
          "personnage": "narrateur",
          "texte": "Une seule chose semble certaine."
        },
        {
          "personnage": "narrateur",
          "texte": "Quelqu'un était avec elle."
        }
      ],
      "next": "ellipse",
      "delai": 1800
    },

    "ellipse": {
      "musique": "melancolie",
      "fond": "noir",
      "dialogues": [
        {
          "personnage": "narrateur",
          "texte": "Quelques jours plus tard..."
        },
        {
          "personnage": "narrateur",
          "texte": "Eva n'a toujours pas été retrouvée."
        },
        {
          "personnage": "narrateur",
          "texte": "La police poursuit ses recherches."
        },
        {
          "personnage": "narrateur",
          "texte": "À l'université, tout semble pourtant continuer comme avant."
        },
        {
          "personnage": "narrateur",
          "texte": "Presque."
        }
      ],
      "next": "universiteRetour",
      "delai": 2000
    },

    "universiteRetour": {
      "musique": "universite",
      "fond": "cour_universite",
      "dialogues": [
        {
          "personnage": "narrateur",
          "texte": "Tu traverses la cour de l'université."
        },
        {
          "personnage": "narrateur",
          "texte": "Des étudiants discutent, d'autres courent pour rejoindre leurs cours."
        },
        {
          "personnage": "narrateur",
          "texte": "À les regarder, il serait presque possible d'oublier qu'Eva manque toujours à l'appel."
        },
        {
          "personnage": "zoe",
          "texte": "{{nomJoueur}} !"
        }
      ],
      "next": "retrouvaillesGroupe",
      "delai": 800
    },

    "retrouvaillesGroupe": {
      "fond": "cour_universite_groupe",
      "dialogues": [
        {
          "personnage": "zoe",
          "texte": "On t'attendait."
        },
        {
          "personnage": "joueur",
          "texte": "Pourquoi ?"
        },
        {
          "personnage": "bryan",
          "texte": "Parce que Zoé a décidé qu'on avait maintenant notre propre cellule d'enquête."
        },
        {
          "personnage": "zoe",
          "texte": "Arrête de présenter ça comme ça."
        },
        {
          "personnage": "emelyne",
          "texte": "Elle a trouvé quelque chose."
        }
      ],
      "choix": [
        {
          "texte": "Demander ce qu'elle a trouvé",
          "message": {
            "personnage": "joueur",
            "texte": "Qu'est-ce que tu as trouvé ?"
          },
          "next": "premierIndice"
        },
        {
          "texte": "Demander d'abord si la police est au courant",
          "message": {
            "personnage": "joueur",
            "texte": "La police est au courant de ce que tu as trouvé ?"
          },
          "effet": {
            "prudence": 1
          },
          "next": "policePasEncore"
        },
        {
          "texte": "Taquiner Zoé sur sa cellule d'enquête",
          "message": {
            "personnage": "joueur",
            "texte": "Donc Bryan avait raison. On a vraiment une cellule d'enquête maintenant."
          },
          "effet": {
            "relationZoe": 1
          },
          "next": "reactionCellule"
        }
      ]
    },

    "reactionCellule": {
      "dialogues": [
        {
          "personnage": "zoe",
          "texte": "Je regrette déjà de t'avoir attendu."
        },
        {
          "personnage": "bryan",
          "texte": "Moi je trouve le nom plutôt bien."
        },
        {
          "personnage": "emelyne",
          "texte": "Vous avez terminé ?"
        },
        {
          "personnage": "zoe",
          "texte": "Oui. Regarde ça."
        }
      ],
      "next": "premierIndice",
      "delai": 700
    },

    "policePasEncore": {
      "dialogues": [
        {
          "personnage": "zoe",
          "texte": "Pas encore."
        },
        {
          "personnage": "emelyne",
          "texte": "Parce qu'on voulait d'abord être certains que ça voulait réellement dire quelque chose."
        },
        {
          "personnage": "zoe",
          "texte": "Et pour ça, on a besoin de toi."
        }
      ],
      "next": "premierIndice",
      "delai": 700
    },

    "premierIndice": {
      "musique": "mystere",
      "fond": "cour_universite_indice",
      "dialogues": [
        {
          "personnage": "narrateur",
          "texte": "Zoé sort son téléphone."
        },
        {
          "personnage": "narrateur",
          "texte": "Une photographie apparaît à l'écran."
        },
        {
          "personnage": "zoe",
          "texte": "J'ai récupéré ça à partir d'une ancienne publication."
        },
        {
          "personnage": "emelyne",
          "texte": "Regarde derrière Eva."
        },
        {
          "personnage": "narrateur",
          "texte": "Tu observes la photo quelques secondes."
        },
        {
          "personnage": "narrateur",
          "texte": "La qualité n'est pas excellente."
        },
        {
          "personnage": "narrateur",
          "texte": "Mais le visage est suffisamment visible."
        }
      ],
      "choix": [
        {
          "texte": "Dire que c'est la personne aperçue avec Eva",
          "message": {
            "personnage": "joueur",
            "texte": "C'est elle. La personne qu'on a vue avec Eva."
          },
          "effet": {
            "indiceInconnuConfirme": true,
            "enquete": 2
          },
          "next": "confirmationIndice"
        },
        {
          "texte": "Dire qu'il est difficile d'en être certain",
          "message": {
            "personnage": "joueur",
            "texte": "Ça lui ressemble, mais avec cette photo je peux pas être certain à cent pour cent."
          },
          "effet": {
            "prudence": 2
          },
          "next": "confirmationPrudente"
        }
      ]
    },

    "confirmationIndice": {
      "dialogues": [
        {
          "personnage": "zoe",
          "texte": "Je savais que je n'étais pas folle."
        },
        {
          "personnage": "emelyne",
          "texte": "Personne n'a dit ça."
        },
        {
          "personnage": "bryan",
          "texte": "Pas aujourd'hui."
        },
        {
          "personnage": "zoe",
          "texte": "Très drôle."
        },
        {
          "personnage": "joueur",
          "texte": "Elle était déjà dans la vie d'Eva avant sa disparition."
        }
      ],
      "next": "nouvelleQuestion",
      "delai": 1000
    },

    "confirmationPrudente": {
      "dialogues": [
        {
          "personnage": "emelyne",
          "texte": "Je pense pareil."
        },
        {
          "personnage": "zoe",
          "texte": "Peut-être. Mais regarde sa veste. Et ses cheveux."
        },
        {
          "personnage": "bryan",
          "texte": "Ça commence quand même à faire beaucoup de coïncidences."
        },
        {
          "personnage": "joueur",
          "texte": "Dans tous les cas, cette personne connaissait probablement Eva avant sa disparition."
        }
      ],
      "next": "nouvelleQuestion",
      "delai": 1000
    },

    "nouvelleQuestion": {
      "dialogues": [
        {
          "personnage": "narrateur",
          "texte": "Un nouveau silence s'installe."
        },
        {
          "personnage": "emelyne",
          "texte": "Donc la vraie question maintenant..."
        },
        {
          "personnage": "zoe",
          "texte": "...c'est qui elle est."
        },
        {
          "personnage": "bryan",
          "texte": "Et comment on la retrouve."
        }
      ],
      "choix": [
        {
          "texte": "Chercher dans les anciennes publications d'Eva",
          "message": {
            "personnage": "joueur",
            "texte": "On commence par les anciennes publications d'Eva. Si cette personne apparaît une fois, elle apparaît peut-être ailleurs."
          },
          "effet": {
            "pisteReseaux": true
          },
          "next": "decisionEnquete"
        },
        {
          "texte": "Chercher dans les anciens messages d'Eva",
          "message": {
            "personnage": "joueur",
            "texte": "Si elle connaissait Eva, son nom est peut-être quelque part dans ses anciens messages."
          },
          "effet": {
            "pisteMessages": true
          },
          "next": "decisionEnquete"
        },
        {
          "texte": "Retourner dans les lieux fréquentés par Eva",
          "message": {
            "personnage": "joueur",
            "texte": "On devrait retourner dans les endroits qu'Eva fréquentait. Quelqu'un l'a peut-être déjà vue avec cette personne."
          },
          "effet": {
            "pisteTemoins": true
          },
          "next": "decisionEnquete"
        }
      ]
    },

    "decisionEnquete": {
      "dialogues": [
        {
          "personnage": "zoe",
          "texte": "Alors on fait ça."
        },
        {
          "personnage": "emelyne",
          "texte": "Et si on trouve quelque chose de sérieux, on transmet tout."
        },
        {
          "personnage": "bryan",
          "texte": "À la police."
        },
        {
          "personnage": "emelyne",
          "texte": "Oui, Bryan. À la police."
        },
        {
          "personnage": "joueur",
          "texte": "On cherche des réponses. Rien de plus."
        },
        {
          "personnage": "narrateur",
          "texte": "Tu regardes une dernière fois la photographie."
        },
        {
          "personnage": "narrateur",
          "texte": "Eva sourit sur l'image."
        },
        {
          "personnage": "narrateur",
          "texte": "Derrière elle, la silhouette inconnue regarde directement dans sa direction."
        }
      ],
      "next": "finChapitre",
      "delai": 1500
    },

    "finChapitre": {
      "musique": "mystere_fin",
      "fond": "photo_inconnue",
      "dialogues": [
        {
          "personnage": "narrateur",
          "texte": "Cette personne connaissait Eva."
        },
        {
          "personnage": "narrateur",
          "texte": "Maintenant, il ne reste plus qu'à découvrir pourquoi."
        }
      ],
      "next": "chapitre2",
      "delai": 2500
    }
  }
}
